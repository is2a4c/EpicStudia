# ============================================================
# EpicStudia — переменные окружения для Docker Compose
# Скопируйте в .env:  cp .env.example .env
# Значения ниже рабочие "из коробки", но ОБЯЗАТЕЛЬНО смените
# секреты (JWT_SECRET, пароли БД) перед публичным деплоем.
# ============================================================

# --- Reverse proxy (наружный порт сайта) ---
WEB_PORT=80

# --- API ---
PORT=5000
# Длинный случайный секрет для подписи JWT. Перегенерировать:
#   openssl rand -hex 48
JWT_SECRET=f2bb4fd2fae60d4e04945c6d5475d255974628d12a8c7a74f6f9ea4ce1c3dcf0c54b2658daa391a30ce656eaa32bf64a
# Базовый URL/Origin (используется для CORS, если он включён в коде).
HOST=http://localhost
ALLOWED_ORIGIN=http://localhost
# RTMP-адрес для публикации прямых трансляций из OBS (медиасервер MediaMTX).
# OBS Server = это значение, Stream Key = id трансляции. Для прода — публичный домен.
STREAM_URL=rtmp://localhost/live
# Внешний порт RTMP-приёма (MediaMTX). Наружу пробрасывается отдельно (NAT/прокси).
RTMP_PORT=1935

# --- База данных (MariaDB, совместима с mysql2) ---
# Хост БД внутри Docker-сети задаётся в docker-compose.yml (DB_URL=db).
DB_NAME=epicstudia
DB_USER=epicstudia
DB_PASSWORD=60cefe33e0676827cf179db5f2190168
DB_ROOT_PASSWORD=8648402a5c1a6da548abe1fb097c9d50

# --- Фронтенд (dev-режим) ---
# В Docker production фронт ходит на относительный /api/v1 (см. docker/web.Dockerfile).
# Для локального `npm run dev` фронт обращается к API напрямую:
VITE_API_URL=http://localhost:5000/api/v1
